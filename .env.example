# ── LLM ──────────────────────────────────────────────────────────────────────
# Which provider powers the chat responses.
LLM_PROVIDER=ollama          # ollama | openai

# LLM model name — provider-neutral.
# Ollama: any model name that has been pulled (e.g. llama3, mistral, phi3).
#   The Docker Compose stack pulls this model automatically on first start.
# OpenAI: the API model name (e.g. gpt-4o, gpt-4o-mini).
# Legacy alias OLLAMA_MODEL is still accepted for backward compatibility.
LLM_MODEL=llama3

# OpenAI: required when LLM_PROVIDER=openai. Leave blank for Ollama.
OPENAI_API_KEY=

# ── Embeddings ────────────────────────────────────────────────────────────────
# Controls how documents and queries are vectorised for retrieval.
# Must match the provider/model used when documents were originally ingested —
# changing this after ingestion will break similarity search.
EMBEDDING_PROVIDER=ollama    # ollama | openai
EMBEDDING_MODEL=nomic-embed-text

# ── Connectors ────────────────────────────────────────────────────────────────
# Optional UUID of an existing collection to attach the built-in DummyConnector.
# Leave unset in production; useful for smoke-testing the connector pipeline.
# DUMMY_COLLECTION_ID=

# ── Infrastructure ────────────────────────────────────────────────────────────
# These are set automatically by Docker Compose. Only override them when running
# the backend outside of Docker (e.g. bare-metal dev or CI).
# POSTGRES_URL=postgresql+asyncpg://pkb:pkb@localhost:5432/pkb
# CHROMADB_HOST=localhost
# CHROMADB_PORT=8001
# OLLAMA_BASE_URL=http://localhost:11434
