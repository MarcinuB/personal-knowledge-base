# LLM Configuration
LLM_PROVIDER=ollama          # ollama | openai
OLLAMA_MODEL=llama3          # any model pulled in Ollama
OPENAI_API_KEY=              # required if LLM_PROVIDER=openai

# Embedding Configuration
EMBEDDING_PROVIDER=ollama    # ollama | openai
EMBEDDING_MODEL=nomic-embed-text

# Infrastructure (set automatically by Docker Compose, only override if running locally)
# POSTGRES_URL=postgresql+asyncpg://pkb:pkb@localhost:5432/pkb
# CHROMADB_HOST=localhost
# CHROMADB_PORT=8001
# OLLAMA_BASE_URL=http://localhost:11434
